# Copy to .env and fill in YOUR OWN values. Placeholders only here — never commit real secrets (.env is git-ignored).

# --- required: bot + database -------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=

# --- dashboard (set ALL THREE to enable it; otherwise only the bot and /healthz run) -------
APP_BASE_URL=https://your-domain.example
DISCORD_CLIENT_SECRET=
SESSION_SECRET=generate-with-openssl-rand-hex-32
# Defaults to APP_BASE_URL + /auth/callback; must match the redirect registered in the Discord developer portal.
DISCORD_OAUTH_REDIRECT_URI=
SESSION_TTL_HOURS=6
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# --- game API -----------------------------------------------------------------------------
AON_API_BASE_URL=https://app.ageofnations.world/api/v1
# Where relative avatar paths (/media/...) live. UNVERIFIED assumption; default https://app.ageofnations.world
AON_MEDIA_BASE_URL=

# --- optional -----------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
DATABASE_SSL=false
# Register slash commands to ONE server instantly while developing (omit in production for global commands).
DISCORD_DEV_GUILD_ID=
